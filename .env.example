# Banco de Dados (SQLite por padrão para desenvolvimento local rápido, ou PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./topiclens.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespw@localhost:5432/topiclens

# Chaves de API para Síntese de Tópicos (LiteLLM)
# Se não fornecidas, o TopicLens utiliza automaticamente rotulador léxico heurístico de alta precisão
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo Padrão de LLM ("gpt-4o-mini", "claude-3-5-haiku-20241022", "heuristic", "ollama/llama3")
DEFAULT_LLM_MODEL=gpt-4o-mini

# URL da API para o Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

